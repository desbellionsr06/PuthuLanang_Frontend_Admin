# =============================================================
# Salin file ini menjadi .env.local lalu isi nilainya.
# =============================================================

# ── Auth.js (NextAuth v5) ─────────────────────────────────────
# Generate dengan:  npx auth secret
AUTH_SECRET=
# Wajib di production / saat di belakang proxy
# AUTH_URL=http://localhost:3000

# ── Google OAuth (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email Google yang boleh masuk admin (pisahkan dengan koma).
# Jika kosong, semua login ditolak.
ADMIN_ALLOWED_EMAILS=admin@example.com

# ── Cloudinary (Cloud Storage untuk foto menu) ────────────────
# Cloudinary Dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder tujuan upload (opsional)
CLOUDINARY_UPLOAD_FOLDER=puthu-lanang/menu

# ── Backend Node.js/Express (opsional; default seperti di bawah) ──
# NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
# NEXT_PUBLIC_ADMIN_KEY=puthu-admin-2026
